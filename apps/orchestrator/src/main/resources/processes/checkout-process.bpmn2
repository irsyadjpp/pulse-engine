  <process id="checkout-process" name="Checkout Process" isExecutable="true">
    <extensionElements />
    <property id="checkoutProcessModel" name="checkoutProcessModel" itemSubjectRef="tns:CheckoutProcessModel" />
    <property id="age" name="age" itemSubjectRef="tns:IntegerType" />
    <property id="occupationClass" name="occupationClass" itemSubjectRef="tns:StringType" />
    <property id="confidenceScore" name="confidenceScore" itemSubjectRef="tns:IntegerType" />
    <property id="totalActiveSumInsured" name="totalActiveSumInsured" itemSubjectRef="tns:NumberType" />
    <property id="requestedSumInsured" name="requestedSumInsured" itemSubjectRef="tns:NumberType" />
    <property id="riskDecision" name="riskDecision" itemSubjectRef="tns:StringType" />
    <property id="riskReasonCode" name="riskReasonCode" itemSubjectRef="tns:StringType" />
    <property id="riskLevel" name="riskLevel" itemSubjectRef="tns:StringType" />
    <property id="paymentAuthorized" name="paymentAuthorized" itemSubjectRef="tns:StringType" />
    <startEvent id="start-event" name="Start">
      <outgoing>flow1</outgoing>
    </startEvent>
    <endEvent id="end-event" name="End">
      <incoming>flow-publish</incoming>
    </endEvent>
    <exclusiveGateway id="risk-gateway" name="Risk Decision" gatewayDirection="Diverging" default="flow-approve">
      <incoming>flow4</incoming>
      <outgoing>flow-approve</outgoing>
      <outgoing>flow-review</outgoing>
      <outgoing>flow-reject</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="payment-gateway" name="Payment Authorized?" default="flow-pay-success" gatewayDirection="Diverging">
      <incoming>flow-pay</incoming>
      <outgoing>flow-pay-success</outgoing>
      <outgoing>flow-pay-fail</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="merge-gateway" name="Merge Results" gatewayDirection="Converging">
      <incoming>flow-finalize</incoming>
      <incoming>flow-finalize-pending</incoming>
      <incoming>flow-rejected</incoming>
      <outgoing>flow-merge</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="reject-merge-gateway" name="Reject Merge" gatewayDirection="Converging">
      <incoming>flow-reject</incoming>
      <incoming>flow-pay-fail</incoming>
      <outgoing>flow-reject-merge</outgoing>
    </exclusiveGateway>
