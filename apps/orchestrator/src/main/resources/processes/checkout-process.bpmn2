<?xml version="1.0" encoding="UTF-8" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:kie="http://www.jboss.org/drools/kie" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:drools="http://www.jboss.org/drools" id="Definitions_1" targetNamespace="http://www.jboss.org/drools/kie">
  <itemDefinition id="CheckoutProcessModelType" structureRef="com.irsyad.pulse.orchestrator.domain.model.CheckoutProcessModel" />
  <message id="CheckoutProcessModelMessage" itemRef="CheckoutProcessModelType" />
  <interface id="_IF_VALIDATE" name="ValidateCheckout" implementationRef="com.irsyad.pulse.orchestrator.process.handler.ValidateCheckoutDelegate">
    <operation id="_OP_VALIDATE" name="execute">
      <inMessageRef>CheckoutProcessModelMessage</inMessageRef>
      <outMessageRef>CheckoutProcessModelMessage</outMessageRef>
    </operation>
  </interface>
  <interface id="_IF_VALIDATE_IDENTITY" name="ValidateIdentity" implementationRef="com.irsyad.pulse.orchestrator.process.handler.ValidateIdentityDelegate">
    <operation id="_OP_VALIDATE_IDENTITY" name="execute">
      <inMessageRef>CheckoutProcessModelMessage</inMessageRef>
      <outMessageRef>CheckoutProcessModelMessage</outMessageRef>
    </operation>
  </interface>
  <interface id="_IF_AUTHORIZE_PAYMENT" name="AuthorizePayment" implementationRef="com.irsyad.pulse.orchestrator.process.handler.AuthorizePaymentDelegate">
    <operation id="_OP_AUTHORIZE_PAYMENT" name="execute">
      <inMessageRef>CheckoutProcessModelMessage</inMessageRef>
      <outMessageRef>CheckoutProcessModelMessage</outMessageRef>
    </operation>
  </interface>
  <interface id="_IF_CREATE_REVIEW" name="CreateReviewCase" implementationRef="com.irsyad.pulse.orchestrator.process.handler.CreateReviewCaseDelegate">
    <operation id="_OP_CREATE_REVIEW" name="execute">
      <inMessageRef>CheckoutProcessModelMessage</inMessageRef>
      <outMessageRef>CheckoutProcessModelMessage</outMessageRef>
    </operation>
  </interface>
  <interface id="_IF_REJECT" name="RejectCheckout" implementationRef="com.irsyad.pulse.orchestrator.process.handler.RejectCheckoutDelegate">
    <operation id="_OP_REJECT" name="execute">
      <inMessageRef>CheckoutProcessModelMessage</inMessageRef>
      <outMessageRef>CheckoutProcessModelMessage</outMessageRef>
    </operation>
  </interface>
  <interface id="_IF_FINALIZE" name="FinalizeCheckout" implementationRef="com.irsyad.pulse.orchestrator.process.handler.FinalizeCheckoutDelegate">
    <operation id="_OP_FINALIZE" name="execute">
      <inMessageRef>CheckoutProcessModelMessage</inMessageRef>
      <outMessageRef>CheckoutProcessModelMessage</outMessageRef>
    </operation>
  </interface>
  <interface id="_IF_ASSESS_RISK" name="AssessRisk" implementationRef="com.irsyad.pulse.orchestrator.process.handler.AssessRiskDelegate">
    <operation id="_OP_ASSESS_RISK" name="execute">
      <inMessageRef>CheckoutProcessModelMessage</inMessageRef>
      <outMessageRef>CheckoutProcessModelMessage</outMessageRef>
    </operation>
  </interface>
  <interface id="_IF_PUBLISH" name="PublishCheckoutCompleted" implementationRef="com.irsyad.pulse.orchestrator.process.handler.PublishCheckoutCompletedDelegate">
    <operation id="_OP_PUBLISH" name="execute">
      <inMessageRef>CheckoutProcessModelMessage</inMessageRef>
      <outMessageRef>CheckoutProcessModelMessage</outMessageRef>
    </operation>
  </interface>
  <process id="checkout-process" name="Checkout Process" isExecutable="true">
    <extensionElements />
    <property id="checkoutProcessModel" name="checkoutProcessModel" itemSubjectRef="tns:CheckoutProcessModel" />
    <startEvent id="start-event" name="Start">
      <outgoing>flow1</outgoing>
    </startEvent>
    <endEvent id="end-event" name="End">
      <incoming>flow-publish</incoming>
    </endEvent>
    <exclusiveGateway id="risk-gateway" name="Risk Decision" gatewayDirection="Diverging" default="flow-reject">
      <incoming>flow4</incoming>
      <outgoing>flow-approve</outgoing>
      <outgoing>flow-review</outgoing>
      <outgoing>flow-reject</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="payment-gateway" name="Payment Authorized?" default="flow-pay-fail" gatewayDirection="Diverging">
      <incoming>flow-pay</incoming>
      <outgoing>flow-pay-success</outgoing>
      <outgoing>flow-pay-fail</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="merge-gateway" name="Merge Results" gatewayDirection="Converging">
      <incoming>flow-finalize</incoming>
      <incoming>flow-review-case</incoming>
      <incoming>flow-rejected</incoming>
      <outgoing>flow-merge</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="reject-merge-gateway" name="Reject Merge" gatewayDirection="Converging">
      <incoming>flow-reject</incoming>
      <incoming>flow-pay-fail</incoming>
      <outgoing>flow-reject-merge</outgoing>
    </exclusiveGateway>
    <serviceTask id="validate-checkout" name="Validate Checkout" implementation="Java" operationRef="_OP_VALIDATE" kie:class="com.irsyad.pulse.orchestrator.process.handler.ValidateCheckoutDelegate">
      <documentation>Technical validation only: mandatory fields, product/merchant validation, request normalization, and duplicate request detection. No business rules or underwriting decisions happen here.</documentation>
      <extensionElements>
        <drools:metaData name="customAutoStart">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="slaDueDate">
          <drools:metaValue>PT2S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="retry">
          <drools:metaValue>3</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="timeout">
          <drools:metaValue>PT5S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="async">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="multiInstance">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="adhoc">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="idempotent">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="businessCapability">
          <drools:metaValue>Checkout Validation</drools:metaValue>
        </drools:metaData>
      </extensionElements>
      <incoming>flow1</incoming>
      <outgoing>flow2</outgoing>
      <ioSpecification id="_IO_VALIDATE">
        <dataInput id="_PARAM_IN" name="Parameter" drools:dtype="com.irsyad.pulse.orchestrator.domain.model.CheckoutProcessModel" />
        <inputSet id="_INPUT_SET">
          <dataInputRefs>_PARAM_IN</dataInputRefs>
        </inputSet>
      </ioSpecification>
      <dataInputAssociation id="_DATA_IN_ASSOC">
        <sourceRef>checkoutProcessModel</sourceRef>
        <targetRef>_PARAM_IN</targetRef>
      </dataInputAssociation>
    </serviceTask>
    <serviceTask id="validate-identity" name="Verify Identity" implementation="Java" operationRef="_OP_VALIDATE_IDENTITY" kie:class="com.irsyad.pulse.orchestrator.process.handler.ValidateIdentityDelegate">
      <documentation>Enrichment step: e-KYC / Dukcapil verification, customer profile lookup, age calculation, occupation class lookup, and existing active sum insured query. Results are written into IdentityVerification on CheckoutProcessModel so downstream nodes never re-call the same services.</documentation>
      <extensionElements>
        <drools:metaData name="customAutoStart">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="slaDueDate">
          <drools:metaValue>PT2S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="retry">
          <drools:metaValue>3</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="timeout">
          <drools:metaValue>PT5S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="async">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="multiInstance">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="adhoc">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="idempotent">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="businessCapability">
          <drools:metaValue>Identity Validation</drools:metaValue>
        </drools:metaData>
      </extensionElements>
      <incoming>flow2</incoming>
      <outgoing>flow-assess</outgoing>
      <ioSpecification id="_IO_VALIDATE_IDENTITY">
        <dataInput id="_PARAM_IN_IDENTITY" name="Parameter" drools:dtype="com.irsyad.pulse.orchestrator.domain.model.CheckoutProcessModel" />
        <inputSet id="_INPUT_SET_IDENTITY">
          <dataInputRefs>_PARAM_IN_IDENTITY</dataInputRefs>
        </inputSet>
      </ioSpecification>
      <dataInputAssociation id="_DATA_IN_ASSOC_IDENTITY">
        <sourceRef>checkoutProcessModel</sourceRef>
        <targetRef>_PARAM_IN_IDENTITY</targetRef>
      </dataInputAssociation>
    </serviceTask>
    <serviceTask id="assess-risk" name="Assess Risk" implementation="Java" operationRef="_OP_ASSESS_RISK" kie:class="com.irsyad.pulse.orchestrator.process.handler.AssessRiskDelegate">
      <documentation>Business Rule Task (DMN): delegates the underwriting decision (APPROVE / REVIEW / REJECT) to the checkout-risk.dmn &quot;AssessRisk&quot; decision table. totalActiveSumInsured (existingActiveSumInsured + requestedSumInsured) is computed before the rules run. All business rules (age bounds, occupation class, eKYC confidence, sum insured limits) are defined exclusively in the DMN file.</documentation>
      <extensionElements>
        <drools:metaData name="customAutoStart">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="slaDueDate">
          <drools:metaValue>PT2S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="retry">
          <drools:metaValue>3</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="timeout">
          <drools:metaValue>PT5S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="async">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="multiInstance">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="adhoc">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="idempotent">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="businessCapability">
          <drools:metaValue>Risk Assessment</drools:metaValue>
        </drools:metaData>
      </extensionElements>
      <incoming>flow-assess</incoming>
      <outgoing>flow4</outgoing>
      <ioSpecification id="_IO_ASSESS_RISK">
        <dataInput id="_PARAM_IN_RISK" name="Parameter" drools:dtype="com.irsyad.pulse.orchestrator.domain.model.CheckoutProcessModel" />
        <inputSet id="_INPUT_SET_RISK">
          <dataInputRefs>_PARAM_IN_RISK</dataInputRefs>
        </inputSet>
      </ioSpecification>
      <dataInputAssociation id="_DATA_IN_ASSOC_RISK">
        <sourceRef>checkoutProcessModel</sourceRef>
        <targetRef>_PARAM_IN_RISK</targetRef>
      </dataInputAssociation>
    </serviceTask>
    <serviceTask id="authorize-payment" name="Authorize Payment" implementation="Java" operationRef="_OP_AUTHORIZE_PAYMENT" kie:class="com.irsyad.pulse.orchestrator.process.handler.AuthorizePaymentDelegate">
      <documentation>Only executed when the underwriting decision is APPROVE. Calls the Payment Gateway (e.g. Midtrans / Xendit / DOKU / Stripe) to authorize the premium payment.</documentation>
      <extensionElements>
        <drools:metaData name="customAutoStart">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="slaDueDate">
          <drools:metaValue>PT2S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="retry">
          <drools:metaValue>3</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="timeout">
          <drools:metaValue>PT5S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="async">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="multiInstance">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="adhoc">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="idempotent">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="businessCapability">
          <drools:metaValue>Payment Authorization</drools:metaValue>
        </drools:metaData>
      </extensionElements>
      <incoming>flow-approve</incoming>
      <outgoing>flow-pay</outgoing>
      <ioSpecification id="_IO_AUTHORIZE_PAYMENT">
        <dataInput id="_PARAM_IN_PAYMENT" name="Parameter" drools:dtype="com.irsyad.pulse.orchestrator.domain.model.CheckoutProcessModel" />
        <inputSet id="_INPUT_SET_PAYMENT">
          <dataInputRefs>_PARAM_IN_PAYMENT</dataInputRefs>
        </inputSet>
      </ioSpecification>
      <dataInputAssociation id="_DATA_IN_ASSOC_PAYMENT">
        <sourceRef>checkoutProcessModel</sourceRef>
        <targetRef>_PARAM_IN_PAYMENT</targetRef>
      </dataInputAssociation>
    </serviceTask>
    <serviceTask id="create-review-case" name="Create Review Case" implementation="Java" operationRef="_OP_CREATE_REVIEW" kie:class="com.irsyad.pulse.orchestrator.process.handler.CreateReviewCaseDelegate">
      <documentation>Non-blocking REVIEW path: creates a manual review case (status PENDING_REVIEW). The BPMN process does not wait for a human decision - it publishes the pending-review status and completes immediately.</documentation>
      <extensionElements>
        <drools:metaData name="customAutoStart">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="slaDueDate">
          <drools:metaValue>PT2S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="retry">
          <drools:metaValue>3</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="timeout">
          <drools:metaValue>PT5S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="async">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="multiInstance">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="adhoc">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="idempotent">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="businessCapability">
          <drools:metaValue>Human Review</drools:metaValue>
        </drools:metaData>
      </extensionElements>
      <incoming>flow-review</incoming>
      <outgoing>flow-review-case</outgoing>
      <ioSpecification id="_IO_CREATE_REVIEW">
        <dataInput id="_PARAM_IN_REVIEW" name="Parameter" drools:dtype="com.irsyad.pulse.orchestrator.domain.model.CheckoutProcessModel" />
        <inputSet id="_INPUT_SET_REVIEW">
          <dataInputRefs>_PARAM_IN_REVIEW</dataInputRefs>
        </inputSet>
      </ioSpecification>
      <dataInputAssociation id="_DATA_IN_ASSOC_REVIEW">
        <sourceRef>checkoutProcessModel</sourceRef>
        <targetRef>_PARAM_IN_REVIEW</targetRef>
      </dataInputAssociation>
    </serviceTask>
    <serviceTask id="reject-checkout" name="Reject Checkout" implementation="Java" operationRef="_OP_REJECT" kie:class="com.irsyad.pulse.orchestrator.process.handler.RejectCheckoutDelegate">
      <documentation>Handles both the underwriting REJECT path and the payment-authorization-failure path. Rejects the checkout via CheckoutService, then releases any previously reserved resource/inventory (release reservation) so it is not held indefinitely, before the rejection status is published.</documentation>
      <extensionElements>
        <drools:metaData name="customAutoStart">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="slaDueDate">
          <drools:metaValue>PT2S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="retry">
          <drools:metaValue>3</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="timeout">
          <drools:metaValue>PT5S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="async">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="multiInstance">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="adhoc">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="idempotent">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="businessCapability">
          <drools:metaValue>Checkout Rejection</drools:metaValue>
        </drools:metaData>
      </extensionElements>
      <incoming>flow-reject-merge</incoming>
      <outgoing>flow-rejected</outgoing>
      <ioSpecification id="_IO_REJECT">
        <dataInput id="_PARAM_IN_REJECT" name="Parameter" drools:dtype="com.irsyad.pulse.orchestrator.domain.model.CheckoutProcessModel" />
        <inputSet id="_INPUT_SET_REJECT">
          <dataInputRefs>_PARAM_IN_REJECT</dataInputRefs>
        </inputSet>
      </ioSpecification>
      <dataInputAssociation id="_DATA_IN_ASSOC_REJECT">
        <sourceRef>checkoutProcessModel</sourceRef>
        <targetRef>_PARAM_IN_REJECT</targetRef>
      </dataInputAssociation>
    </serviceTask>
    <serviceTask id="finalize-checkout" name="Finalize Checkout" implementation="Java" operationRef="_OP_FINALIZE" kie:class="com.irsyad.pulse.orchestrator.process.handler.FinalizeCheckoutDelegate">
      <documentation>Executed after successful payment authorization: updates checkout status, creates the policy, invoice and audit trail, and stores the payment reference.</documentation>
      <extensionElements>
        <drools:metaData name="customAutoStart">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="slaDueDate">
          <drools:metaValue>PT2S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="retry">
          <drools:metaValue>3</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="timeout">
          <drools:metaValue>PT5S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="async">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="multiInstance">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="adhoc">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="idempotent">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="businessCapability">
          <drools:metaValue>Checkout Finalization</drools:metaValue>
        </drools:metaData>
      </extensionElements>
      <incoming>flow-pay-success</incoming>
      <outgoing>flow-finalize</outgoing>
      <ioSpecification id="_IO_FINALIZE">
        <dataInput id="_PARAM_IN_FINALIZE" name="Parameter" drools:dtype="com.irsyad.pulse.orchestrator.domain.model.CheckoutProcessModel" />
        <inputSet id="_INPUT_SET_FINALIZE">
          <dataInputRefs>_PARAM_IN_FINALIZE</dataInputRefs>
        </inputSet>
      </ioSpecification>
      <dataInputAssociation id="_DATA_IN_ASSOC_FINALIZE">
        <sourceRef>checkoutProcessModel</sourceRef>
        <targetRef>_PARAM_IN_FINALIZE</targetRef>
      </dataInputAssociation>
    </serviceTask>
    <serviceTask id="publish-completed" name="Publish Checkout Completed" implementation="Java" operationRef="_OP_PUBLISH" kie:class="com.irsyad.pulse.orchestrator.process.handler.PublishCheckoutCompletedDelegate">
      <documentation>Final node of the BPMN process. Builds a CheckoutCompletedEvent (carrying the terminal status: COMPLETED / PENDING_REVIEW / REJECTED) and publishes it to Kafka topic pulse.checkout.completed.v1. This event is the integration point between the Orchestrator and Pulse Engine, which continues asynchronously (Observe -&gt; Understand -&gt; Explain -&gt; Decide -&gt; Learn -&gt; Persist -&gt; Publish Insight) on topic pulse.insight.generated.v1.</documentation>
      <extensionElements>
        <drools:metaData name="customAutoStart">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="slaDueDate">
          <drools:metaValue>PT2S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="retry">
          <drools:metaValue>3</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="timeout">
          <drools:metaValue>PT5S</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="async">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="multiInstance">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="adhoc">
          <drools:metaValue>false</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="idempotent">
          <drools:metaValue>true</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="businessCapability">
          <drools:metaValue>Checkout Event Publishing</drools:metaValue>
        </drools:metaData>
      </extensionElements>
      <incoming>flow-merge</incoming>
      <outgoing>flow-publish</outgoing>
      <ioSpecification id="_IO_PUBLISH">
        <dataInput id="_PARAM_IN_PUBLISH" name="Parameter" drools:dtype="com.irsyad.pulse.orchestrator.domain.model.CheckoutProcessModel" />
        <inputSet id="_INPUT_SET_PUBLISH">
          <dataInputRefs>_PARAM_IN_PUBLISH</dataInputRefs>
        </inputSet>
      </ioSpecification>
      <dataInputAssociation id="_DATA_IN_ASSOC_PUBLISH">
        <sourceRef>checkoutProcessModel</sourceRef>
        <targetRef>_PARAM_IN_PUBLISH</targetRef>
      </dataInputAssociation>
    </serviceTask>
    <sequenceFlow id="flow1" sourceRef="start-event" targetRef="validate-checkout" />
    <sequenceFlow id="flow2" sourceRef="validate-checkout" targetRef="validate-identity" />
    <sequenceFlow id="flow-assess" sourceRef="validate-identity" targetRef="assess-risk" />
    <sequenceFlow id="flow4" sourceRef="assess-risk" targetRef="risk-gateway" />
    <sequenceFlow id="flow-approve" name="APPROVE" sourceRef="risk-gateway" targetRef="authorize-payment">
      <conditionExpression xsi:type="tFormalExpression">return checkoutProcessModel.getRisk() != null &amp;&amp; &quot;APPROVE&quot;.equals(checkoutProcessModel.getRisk().getDecision());</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-review" name="REVIEW" sourceRef="risk-gateway" targetRef="create-review-case">
      <conditionExpression xsi:type="tFormalExpression">return checkoutProcessModel.getRisk() != null &amp;&amp; &quot;REVIEW&quot;.equals(checkoutProcessModel.getRisk().getDecision());</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-reject" name="REJECT" sourceRef="risk-gateway" targetRef="reject-merge-gateway">
      <conditionExpression xsi:type="tFormalExpression">return checkoutProcessModel.getRisk() == null || &quot;REJECT&quot;.equals(checkoutProcessModel.getRisk().getDecision());</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-pay" sourceRef="authorize-payment" targetRef="payment-gateway" />
    <sequenceFlow id="flow-pay-success" name="Authorized" sourceRef="payment-gateway" targetRef="finalize-checkout">
      <conditionExpression xsi:type="tFormalExpression">return checkoutProcessModel.getPayment() != null &amp;&amp; Boolean.TRUE.equals(checkoutProcessModel.getPayment().getAuthorized());</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-review-case" sourceRef="create-review-case" targetRef="merge-gateway" />
    <sequenceFlow id="flow-finalize" sourceRef="finalize-checkout" targetRef="merge-gateway" />
    <sequenceFlow id="flow-rejected" sourceRef="reject-checkout" targetRef="merge-gateway" />
    <sequenceFlow id="flow-reject-merge" sourceRef="reject-merge-gateway" targetRef="reject-checkout" />
    <sequenceFlow id="flow-merge" sourceRef="merge-gateway" targetRef="publish-completed" />
    <sequenceFlow id="flow-publish" sourceRef="publish-completed" targetRef="end-event" />
    <sequenceFlow id="flow-pay-fail" sourceRef="payment-gateway" targetRef="reject-merge-gateway" name="Failed">
      <conditionExpression xsi:type="tFormalExpression">return checkoutProcessModel.getPayment() == null || !Boolean.TRUE.equals(checkoutProcessModel.getPayment().getAuthorized());</conditionExpression>
    </sequenceFlow>
  </process>
