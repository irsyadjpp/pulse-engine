    </serviceTask>
    <sequenceFlow id="flow1" sourceRef="start-event" targetRef="validate-checkout" />
    <sequenceFlow id="flow2" sourceRef="validate-checkout" targetRef="validate-identity" />
    <sequenceFlow id="flow-assess" sourceRef="validate-identity" targetRef="assess-risk" />
    <sequenceFlow id="flow4" sourceRef="assess-risk" targetRef="risk-gateway" />
    <sequenceFlow id="flow-approve" name="APPROVE" sourceRef="risk-gateway" targetRef="authorize-payment">
      <conditionExpression xsi:type="tFormalExpression">return &quot;APPROVE&quot;.equals(riskDecision);</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-review" name="REVIEW" sourceRef="risk-gateway" targetRef="create-review-case">
      <conditionExpression xsi:type="tFormalExpression">return &quot;REVIEW&quot;.equals(riskDecision);</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-reject" name="REJECT" sourceRef="risk-gateway" targetRef="reject-merge-gateway">
      <conditionExpression xsi:type="tFormalExpression">return &quot;REJECT&quot;.equals(riskDecision);</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-pay" sourceRef="authorize-payment" targetRef="payment-gateway" />
    <sequenceFlow id="flow-pay-success" name="Authorized" sourceRef="payment-gateway" targetRef="finalize-checkout">
      <conditionExpression xsi:type="tFormalExpression">return Boolean.TRUE.equals(paymentAuthorized) || &quot;true&quot;.equalsIgnoreCase(paymentAuthorized);</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-review-case" sourceRef="create-review-case" targetRef="finalize-pending" />
    <sequenceFlow id="flow-finalize" sourceRef="finalize-checkout" targetRef="merge-gateway" />
    <sequenceFlow id="flow-finalize-pending" sourceRef="finalize-pending" targetRef="merge-gateway" />
    <sequenceFlow id="flow-rejected" sourceRef="reject-checkout" targetRef="merge-gateway" />
    <sequenceFlow id="flow-reject-merge" sourceRef="reject-merge-gateway" targetRef="reject-checkout" />
    <sequenceFlow id="flow-merge" sourceRef="merge-gateway" targetRef="publish-completed" />
    <sequenceFlow id="flow-publish" sourceRef="publish-completed" targetRef="end-event" />
    <sequenceFlow id="flow-pay-fail" sourceRef="payment-gateway" targetRef="reject-merge-gateway" name="Failed">
      <conditionExpression xsi:type="tFormalExpression">return !Boolean.TRUE.equals(paymentAuthorized);</conditionExpression>
    </sequenceFlow>
  </process>
