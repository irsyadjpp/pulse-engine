# ============================================================================
# Pulse Engine — Root .gitignore
# ============================================================================
# Multi-module Maven + Quarkus + Spring Boot + Docker Compose (Kafka/Postgres)
# Patterns without a leading slash match at any depth, so `target/` applies
# to every module under apps/ and shared/.

# ----------------------------------------------------------------------------
# Build output
# ----------------------------------------------------------------------------
target/
build/
classes/
out/
*.class
*.jar
*.war
*.ear
*.nar

# Maven
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.flattened-pom.xml
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
# Keep the wrapper scripts themselves versioned
!mvnw
!mvnw.cmd

# Gradle (if introduced later)
.gradle/
build/

# ----------------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------------
*.log
logs/
**/logs/

# ----------------------------------------------------------------------------
# Local databases & state directories (when services run outside Docker)
# ----------------------------------------------------------------------------
pgdata/
postgres-data/
*.h2.db
*.mv.db
*.db
*.sqlite
kafka-logs/
zookeeper-data/
data/

# ----------------------------------------------------------------------------
# Secrets & environment files
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.p8
secrets/
.certs/

# ----------------------------------------------------------------------------
# Local / profile-specific configuration
# ----------------------------------------------------------------------------
application-local.*
application-dev.local.*
*.local.yml
*.local.yaml
*.local.properties
config/local/

# Quarkus
.quarkus/

# Spring Boot
.springBeans

# ----------------------------------------------------------------------------
# Test output
# ----------------------------------------------------------------------------
surefire-reports/
jacoco.exec
coverage/
test-results/

# ----------------------------------------------------------------------------
# IDEs & Editors
# ----------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
.idea/*
*.ipr
*.iws
*.iml

# Eclipse
.project
.classpath
.settings/
bin/

# NetBeans
nbproject/
nb-configuration.xml
nbactions.xml

# Visual Studio Code
.vscode/
*.code-workspace
.factorypath

# Vim
*.swp
*.swo
*~

# Emacs
*#
.#*

# ----------------------------------------------------------------------------
# Operating systems
# ----------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ----------------------------------------------------------------------------
# Docker / container-local overrides (never commit machine-specific overrides)
# ----------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.override.yaml
*.override.yml
*.override.yaml
docker-data/

# ----------------------------------------------------------------------------
# Patch / diff artifacts
# ----------------------------------------------------------------------------
*.orig
*.rej
*.patch
*.diff

# ----------------------------------------------------------------------------
# Quarkus CLI plugin cache
# ----------------------------------------------------------------------------
/.quarkus/cli/plugins/

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
*.tmp
*.bak
*.swp
.idea/