        {
          "name": "Start Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checkoutId\": \"CHK-001\",\n  \"customerId\": \"CUST-001\",\n  \"shippingAddressId\": \"ADDR-001\",\n  \"payment\": {\n    \"method\": \"CREDIT_CARD\",\n    \"bank\": \"BCA\"\n  },\n  \"items\": [\n    {\n      \"productId\": \"PROD-1001\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"PROD-2002\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{orchestratorBase}}/api/v1/checkouts",
              "host": ["{{orchestratorBase}}"],
              "path": ["api", "v1", "checkouts"]
            },
            "description": "Memulai proses checkout BPMN (Kogito). Merupakan endpoint async — mengembalikan 202 Accepted dengan processId. Body request mengikuti DTO CheckoutRequest: checkoutId, customerId, shippingAddressId, payment {method, bank}, items [{productId, quantity}]."
          },
          "response": [
            {
              "name": "202 Accepted — Checkout started",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{orchestratorBase}}/api/v1/checkouts",
