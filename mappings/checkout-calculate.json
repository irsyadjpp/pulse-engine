      "tax": 110000.00,
      "discount": 0.00,
      "totalAmount": 1110000.00,
      "currency": "IDR",
      "message": "Checkout calculation completed: Subtotal=1000000.00, Tax=110000.00, Discount=0.00, Total=1110000.00"
    }
  }
}